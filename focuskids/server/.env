# ── Server ──────────────────────────────────────────────
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# ── PostgreSQL ──────────────────────────────────────────
# Option A: full connection string
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/focuskids

# Option B: individual vars (used when DATABASE_URL is absent)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=focuskids
DB_USER=postgres
DB_PASSWORD=postgres

# ── Auth (optional for MVP) ──────────────────────────────
JWT_SECRET=focuskids_super_secret_change_in_production
