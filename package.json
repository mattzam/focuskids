{
  "name": "focuskids",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "install:all": "npm install && cd client && npm install && cd ../server && npm install",
    "start": "node server/index.js",
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "server": "nodemon server/index.js",
    "client": "cd client && npm start"
  },
  "dependencies": {
    "concurrently": "^8.2.2",
    "nodemon": "^3.1.0"
  }
}
